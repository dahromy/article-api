###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
###< symfony/framework-bundle ###

###> doctrine/mongodb-odm-bundle ###
# Production MongoDB configuration
# MONGODB_URL=mongodb://username:password@production-host:27017/database
# MONGODB_DB=article_api_prod
###< doctrine/mongodb-odm-bundle ###

###> lexik/jwt-authentication-bundle ###
# Generate new keys for production:
# php bin/console lexik:jwt:generate-keypair
JWT_TTL=3600
###< lexik/jwt-authentication-bundle ###

###> Application Configuration ###
# API Configuration
API_VERSION=1.0.0
API_RATE_LIMIT_READ=500
API_RATE_LIMIT_WRITE=50
API_RATE_LIMIT_AUTH=3

# Cache Configuration - Use Redis in production
CACHE_DEFAULT_TTL=7200
CACHE_ARTICLES_TTL=3600
CACHE_USERS_TTL=7200
# REDIS_URL=redis://redis-host:6379

# Security Configuration
CORS_ALLOW_ORIGIN=https://yourdomain.com
SECURITY_FORCE_HTTPS=true

# Logging Configuration
LOG_LEVEL=warning
LOG_API_REQUESTS=true
###< Application Configuration ###